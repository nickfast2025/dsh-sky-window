{
  "name": "dsh-sky-window",
  "version": "0.1.1",
  "description": "A living illustrated sky for the real DeepSeek Harness workspace.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "docs", "cordis.patch.yml", "README.md", "README.en.md"],
  "engines": { "node": ">=22" },
  "keywords": ["dsh-plugin", "dsh-plugin-theme", "deepseek-harness", "sky"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.cjs src/client.test.cjs ../sky-clock/solar.test.cjs",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
